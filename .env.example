# Copy to .env for local work. On the server, set these as environment variables.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed once the site is on a real domain, e.g. https://yourapp.example.com
CSRF_TRUSTED_ORIGINS=
# Neon connection string (use the one that ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Get a key at https://aistudio.google.com/apikey
# Optional local PostgreSQL URL used only by `python manage.py test`.
# Django creates test_ielts_local on this local server; this role needs CREATEDB.
TEST_DATABASE_URL=postgresql://ielts_test_user:CHANGE_ME@127.0.0.1:5432/ielts_local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini chat controls; thinking level takes precedence over budget.
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=
GEMINI_TIMEOUT_SECONDS=25
GEMINI_503_RETRIES=2
CHAT_DAILY_LIMIT=40
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Defaults to Groq when configured, otherwise Gemini (silent backup).
CHAT_AI_PROVIDER=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MAX_TOKENS=2000
GROQ_CHAT_REASONING_EFFORT=low
CHAT_AI_FALLBACK_FROM_GROQ=true
# The Groq API key above is shared; these following Groq settings are for Writing evaluation only.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_EVALUATIONS_DAILY_LIMIT=3
# Create an API key in Resend. Without a verified domain, Resend only allows
# testing to your own address using onboarding@resend.dev.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
